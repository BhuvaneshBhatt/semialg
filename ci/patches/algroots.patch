+def smallest_coefficient(polynomial, ambient):
+    """Return a nonconstant coefficient of least rational total degree, up to sign."""
+    variables, constants = ambient.symbols, ambient.domain
+
+    def degree(value):
+        numerator, denominator = sp.fraction(value)
+        return max(
+            sp.Poly(numerator, *variables, domain=constants).total_degree(),
+            sp.Poly(denominator, *variables, domain=constants).total_degree(),
+        )
+
+    candidates = rational_values(
+        ambient,
+        (
+            -coefficient
+            for _, coefficient in polynomial.terms(order="grlex")
+            if coefficient.free_symbols & set(variables)
+        ),
+    )
+    if not candidates:
+        raise QuotientAlgebraError("the factor product has no nonconstant coefficient")
+    return min(candidates, key=degree)
