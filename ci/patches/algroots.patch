+def rational_values(ambient, values):
+    """Normalize exact values in a constant or rational-function field."""
+    if not isinstance(ambient, Domain) or not ambient.is_Exact or not ambient.is_Field:
+        raise QuotientAlgebraError("an exact coefficient field is required")
+    normalized = []
+    for value in values:
+        value = value.as_expr() if isinstance(value, sp.Poly) else sp.sympify(value)
+        if value.has(sp.Float):
+            raise QuotientAlgebraError("function-field elements must be exact")
+        try:
+            normalized.append(ambient.to_sympy(field_element(value, ambient)))
+        except (
+            CoercionFailed,
+            sp.PolynomialError,
+            ValueError,
+            TypeError,
+            ZeroDivisionError,
+        ) as exc:
+            raise QuotientAlgebraError(
+                "an exact rational function over the declared constants and variables is required"
+            ) from exc
+    return tuple(normalized)
+
+
+def coefficient_polynomial(polynomial, variables, ambient):
+    """Rebase K[variables,parameters] into K(parameters)[variables] using native coefficients.
+
+    The polynomial generators must list ``variables`` followed by the ambient
+    parameters, with coefficient domain equal to ``ambient.domain``.
+
+    Expression conversion can split an algebraic number into factors outside K;
+    for example sqrt(-3) may become sqrt(3)*I although neither factor lies in K.
+    Group monomials directly so the declared algebraic embedding is preserved.
+    """
+    variables = tuple(variables)
+    if polynomial.gens != (*variables, *ambient.symbols) or polynomial.domain != ambient.domain:
+        raise QuotientAlgebraError(
+            "polynomial coordinates and coefficient field must match the rebasing"
+        )
+    split = len(variables)
+    grouped = {}
+    for monomial, coefficient in polynomial.rep.to_dict().items():
+        grouped.setdefault(monomial[:split], {})[monomial[split:]] = coefficient
+    coefficients = {
+        monomial: ambient.field.new(ambient.field.ring.from_dict(terms))
+        for monomial, terms in grouped.items()
+    }
+    return sp.Poly.from_dict(coefficients, *variables, domain=ambient)
+
