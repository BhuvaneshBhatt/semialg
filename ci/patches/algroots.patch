+
+def _luroth_polynomial(ambient, values, x):
+    t = ambient.symbols[0]
+    gcd = None
+    for value in values:
+        p, q = _fraction(value)
+        poly = polynomial(p.subs(t, x) - value * q.subs(t, x), (x,), ambient)
+        if not poly.is_zero:
+            gcd = poly.monic() if gcd is None else gcd.gcd(poly).monic()
+    return gcd
