+"""Birational plane models for fields generated by arbitrary coefficient lists."""
+
+from dataclasses import dataclass
+
+import sympy as sp
+
+from .curves import CurveError, PlaneCurve
+from .domains import field_element
+from .subfields import field_normal_form
+
+
+@dataclass(frozen=True)
+class CoefficientCurveModel:
+    """A plane model and both embeddings of the original coefficient field."""
+
+    field: object
+    curve: PlaneCurve
+    coordinate_expressions: tuple[sp.Expr, sp.Expr]
+    generator_images: tuple[sp.Expr, ...]
+
+    def to_ambient(self, expression):
+        expression = sp.sympify(expression)
+        if expression.free_symbols - set(self.curve.variables):
+            raise CurveError("plane expressions may use only the plane coordinates")
+        return self.field.to_ambient(
+            expression.xreplace(
+                dict(zip(self.curve.variables, self.coordinate_expressions, strict=True))
+            )
+        )
+
+    def verify(self):
+        if not self.field.verify() or self.curve.domain != self.field.constants:
+            return False
+        if len(self.generator_images) != len(self.field.generators):
+            return False
+        if self.to_ambient(self.curve.polynomial.as_expr()) != 0:
+            return False
+        ambient = self.field.ambient
+        if any(
+            field_normal_form(ambient, self.to_ambient(image) - generator) != 0
+            for image, generator in zip(self.generator_images, self.field.generators, strict=True)
+        ):
+            return False
+        A = self.curve.function_field()
+        substitutions = dict(zip(self.field.generator_symbols, self.generator_images, strict=True))
+        return all(
+            field_normal_form(A, expression.xreplace(substitutions) - coordinate) == 0
+            for expression, coordinate in zip(
+                self.coordinate_expressions, self.curve.variables, strict=True
+            )
+        )
+
+
+@dataclass(frozen=True)
+class CoefficientFieldParametrization:
+    """A rational generator over constants, embedded in the original ambient field."""
+
+    model: CoefficientCurveModel
+    parametrization: object
+
+    @property
+    def parameter(self):
+        return self.parametrization.parameter
+
+    @property
+    def generator_expression(self):
+        return self.parametrization.inverse.xreplace(
+            dict(zip(self.model.curve.variables, self.model.coordinate_expressions, strict=True))
+        )
+
+    @property
+    def generator(self):
+        return self.model.field.to_ambient(self.generator_expression)
+
+    @property
+    def coefficient_images(self):
+        substitutions = dict(
+            zip(self.model.curve.variables, self.parametrization.affine_coordinates, strict=True)
+        )
+        Kt = self.model.field.constants.frac_field(self.parameter)
+        return tuple(
+            Kt.to_sympy(field_element(image.subs(substitutions, simultaneous=True), Kt))
+            for image in self.model.generator_images
+        )
+
+    @property
+    def forward_guard(self):
+        return sp.And(*(sp.Ne(sp.fraction(c)[1], 0) for c in self.coefficient_images))
+
+    @property
+    def inverse_guard(self):
+        return sp.Ne(sp.fraction(sp.cancel(self.generator_expression))[1], 0)
+
+    def to_ambient(self, expression):
+        expression = sp.sympify(expression)
+        if expression.free_symbols - {self.parameter}:
+            raise CurveError("expression may use only the rational parameter")
+        return field_normal_form(
+            self.model.field.ambient, expression.subs(self.parameter, self.generator)
+        )
+
+    def to_source(self, value):
+        membership = self.model.field.express(value)
+        if not membership.belongs:
+            raise CurveError("element does not belong to the coefficient field")
+        expression = membership.expression.xreplace(
+            dict(zip(self.model.field.generator_symbols, self.coefficient_images, strict=True))
+        )
+        Kt = self.model.field.constants.frac_field(self.parameter)
+        return Kt.to_sympy(field_element(expression, Kt))
+
+    def verify(self):
+        if not self.model.verify() or self.parametrization.curve != self.model.curve:
+            return False
+        if (
+            self.parametrization.domain != self.model.field.constants
+            or not self.parametrization.verify()
+        ):
+            return False
+        if self.to_source(self.generator) != self.parameter:
+            return False
+        ambient = self.model.field.ambient
+        return all(
+            field_normal_form(ambient, self.to_ambient(image) - value) == 0
+            for image, value in zip(
+                self.coefficient_images, self.model.field.generators, strict=True
+            )
+        )
+
+
+def coefficient_curve_model(field):
+    from .quotient import QuotientAlgebra
+
+    if field.base_index is None:
+        raise CurveError("a curve model requires transcendence degree one over the constants")
+    X, Y = sp.Dummy("coefficient_base"), sp.Dummy("coefficient_primitive")
+    base = field.generator_symbols[field.base_index]
+    if isinstance(field.presentation, QuotientAlgebra):
+        presentation = field.presentation
+        primitive = presentation.subfield(presentation.variables).primitive_element(Y)
+        relation = primitive.field.groebner_basis.polys[0].as_expr().subs(base, X)
+        coordinates = (base, primitive.ambient_generator)
+        images = tuple(
+            X if s == base else primitive.to_source(s).subs(base, X)
+            for s in field.generator_symbols
+        )
+    else:
+        relation = Y
+        coordinates = (base, sp.Integer(0))
+        images = (X,)
+    relation = sp.fraction(sp.cancel(relation))[0]
+    curve = PlaneCurve.from_polynomial(relation, (X, Y), domain=field.constants)
+    result = CoefficientCurveModel(field, curve, coordinates, images)
+    if not result.verify():
+        raise ArithmeticError("coefficient plane model failed its embedding identities")
+    return result
